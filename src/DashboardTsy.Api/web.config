<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS altında ASP.NET Core Module (ANCM) konfigürasyonu.
  stdoutLogEnabled=true — Console.Out / ILogger çıktısı .\logs\stdout_<pid>_<timestamp>.log dosyasına yazılır.
  MobileAuthController'ın login/OTP loglarını prod'da bu dosyalardan takip ediyoruz.
  logs\ klasörü yoksa ANCM otomatik oluşturur. Kalıcı log rotasyonu Serilog vb. eklenmeden önce geçici çözüm.

  processPath / arguments alanları publish sırasında SDK tarafından üretilir; bu dosya publish output'una
  kopyalanırken ilgili değerler transform edilir (Microsoft.NET.Sdk.Web / _TransformWebConfig target'ı).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\DashboardTsy.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
