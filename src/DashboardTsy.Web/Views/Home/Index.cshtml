<!-- Monthly Skeleton -->
<div id="monthlyTableSkeleton" class="page-skeleton" style="display:none;">
    <div class="skeleton-table">
        @for (int i = 0; i < 12; i++)
        {
            <div class="skeleton-table-row">
                <div class="skeleton-bar" style="width:30px;height:16px"></div>
                <div class="skeleton-bar" style="width:55%;height:16px"></div>
                <div class="skeleton-bar" style="width:20%;height:16px"></div>
                <div class="skeleton-bar" style="width:20%;height:16px"></div>
                <div class="skeleton-bar" style="width:15%;height:16px"></div>
                <div class="skeleton-bar" style="width:20%;height:16px"></div>
                <div class="skeleton-bar" style="width:20%;height:16px"></div>
                <div class="skeleton-bar" style="width:15%;height:16px"></div>
            </div>
        }
    </div>
</div>

<!-- Monthly Table -->
<div class="table-container" id="monthlyTable" style="display:none;">
    <div class="table-wrapper">
      <table class="data-table" id="monthlyDataTable">
          <thead>
              <tr>
                  <th class="col-index" rowspan="2"></th>
                  <th class="col-expand" rowspan="2"></th>
                  <th class="col-left valign-bottom" rowspan="2">
                    <span data-monthly-header="ProductNameTitle"></span>
                  </th>
                  <th colspan="3" class="col-group-header selected">
                    <div class="col-group-header-content">
                      <span data-monthly-header="MonthGroupTitle"></span>
                      <span class="info-icon" data-tooltip="Aylık kolon, içinde bulunulan ayın ortalama bakiyelerini gösterir.">
                          <img src="~/images/info.svg" alt="" asp-append-version="true" />
                      </span>
                    </div>
                  </th>
                  <th colspan="3" class="col-group-header">
                    <div class="col-group-header-content">
                      <span data-monthly-header="YearGroupTitle"></span>
                      <span class="info-icon" data-tooltip="Yıllık kolon içinde bulunulan yılın gün bazlı kümülatif ortalama bakiyelerini gösterir.">
                          <img src="~/images/info.svg" alt="" asp-append-version="true" />
                      </span>
                    </div>
                  </th>
                  <th class="col-detail" rowspan="2"></th>
              </tr>
              <tr>
                  <th class="col-selected col-selected-first"><span data-monthly-header="MonthActualTitle"></span> <i class="sort-icon" data-sort-by="2"><img class="sort-up" src="/images/sort-asc.svg" alt="" /><img class="sort-down" src="/images/sort-dec.svg" alt="" /></i></th>
                  <th class="col-selected"><span data-monthly-header="MonthTargetTitle"></span> <i class="sort-icon" data-sort-by="3"><img class="sort-up" src="/images/sort-asc.svg" alt="" /><img class="sort-down" src="/images/sort-dec.svg" alt="" /></i></th>
                  <th class="col-selected col-selected-last" data-monthly-header="MonthHGTitle"></th>
                  <th><span data-monthly-header="YearActualTitle"></span> <i class="sort-icon" data-sort-by="4"><img class="sort-up" src="/images/sort-asc.svg" alt="" /><img class="sort-down" src="/images/sort-dec.svg" alt="" /></i></th>
                  <th><span data-monthly-header="YearTargetTitle"></span> <i class="sort-icon" data-sort-by="5"><img class="sort-up" src="/images/sort-asc.svg" alt="" /><img class="sort-down" src="/images/sort-dec.svg" alt="" /></i></th>
                  <th data-monthly-header="YearHGTitle"></th>
              </tr>
          </thead>
          <tbody id="monthlyTableBody">
          </tbody>
      </table>
    </div>
    <div class="table-legend">
      <span class="legend-note">Tablodaki değerler /1000 olarak verilmektedir.</span>
      <div class="legend-colors">
        <span class="legend-value">0</span>
        <span class="legend-bar ratio-red-bg"></span>
        <span class="legend-value">75</span>
        <span class="legend-bar ratio-orange-bg"></span>
        <span class="legend-value">100</span>
        <span class="legend-bar ratio-green-bg"></span>
        <span class="legend-value">120</span>
        <span class="legend-bar ratio-blue-bg"></span>
      </div>
      <div class="legend-actions">
        <div class="download-pdf-btn" data-pdf="report" style="cursor:pointer;">
          <img src="~/images/download.svg" alt="PDF İndir" />
          <span>PDF İndir</span>
        </div>
      </div>
    </div>
</div>

@* Ürün Detay Modalı paylaşılan partial'a taşındı (hedef + verim ortak kullanır). *@
@await Html.PartialAsync("_ReportDetailModal")

<!-- USD Kur Detayı Modal -->
<div class="usd-kur-overlay" id="usdKurOverlay">
  <div class="usd-kur-modal" role="dialog" aria-modal="true" aria-labelledby="usdKurModalTitle">
    <div class="usd-kur-modal-header">
      <div class="usd-kur-modal-titles">
        <h2 class="usd-kur-modal-title" id="usdKurModalTitle">Hesaplamada Kullanılan USD Kurları</h2>
        <p class="usd-kur-modal-subtitle">Vadesiz YP değerleri aşağıdaki USD kurları kullanılarak hesaplanmıştır.</p>
      </div>
      <button class="usd-kur-close" id="usdKurClose" aria-label="Kapat">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <div class="usd-kur-rows" id="usdKurRows"></div>
    <div class="usd-kur-footer" id="usdKurFooter"></div>
  </div>
</div>

@section Scripts {
    @{
        var sessionUser = System.Text.Json.JsonSerializer.Deserialize<DashboardTsy.Web.Models.UsersDto>(
            Context.Session.GetString("User") ?? "null");
    }
    <script>
        window.USER_CODE = @Html.Raw(Json.Serialize(sessionUser?.DomainName));
    </script>
    <link rel="stylesheet" href="~/css/date-picker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usd-kur-modal.css" asp-append-version="true" />
    <script src="~/assets/lib/html2canvas/html2canvas.min.js" asp-append-version="true"></script>
    <script src="~/assets/lib/jspdf/jspdf.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/date-picker.js" asp-append-version="true"></script>
    <script src="~/js/target-report.js" asp-append-version="true"></script>
    <script src="~/js/download-pdf.js" asp-append-version="true"></script>
    <script src="~/js/report-detail.js" asp-append-version="true"></script>
    <script src="~/js/report-trend.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Aktif tipe (Hacim/Adet) göre ilgili fark toggle'ı — mobil menü onu yönetir.
            function activeDiffToggle() {
                var type = $('.segment[data-type].active').attr('data-type');
                return type === 'adet' ? '#quantityDiffToggle' : '#diffToggle';
            }
            // Etiketi GERÇEK toggle durumuna göre yaz: farklar açıkken "Gizle", kapalıyken "Göster".
            function syncMobileDiffLabel() {
                var active = $(activeDiffToggle()).attr('data-active') === 'true';
                $('#mobileDiffBtnText').text(active ? 'Farkları Gizle' : 'Farkları Göster');
            }
            syncMobileDiffLabel();
            // Hacim/Adet değişince aktif toggle değişir → etiketi güncelle.
            $(document).on('click', '.segment[data-type]', function () { setTimeout(syncMobileDiffLabel, 0); });

            $('#mobileDiffBtn').on('click', function () {
                $(activeDiffToggle()).trigger('click');
                syncMobileDiffLabel();
                $(this).closest('details').removeAttr('open');
            });
            $('#mobilePdfBtn').on('click', function () {
                $('#downloadPdfBtn').trigger('click');
                $(this).closest('details').removeAttr('open');
            });
            $('#mobileUsdKurBtn').on('click', function () {
                $(this).closest('details').removeAttr('open');
            });
        });
    </script>
}
