@{
    ViewData["Title"] = "Mobil Giris";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Yonetici Rapor Platformu</title>
    <link href="~/assets/lib/bootstrap/bootstrap-grid.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/loading.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/lib/jqueryconfirm/jquery-confirm.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="login-wrapper">
        <div class="login-container">
            <div class="login-header">
                <img src="~/images/denizbank-logo.svg" alt="DenizBank" />
                <h2>Yonetici Rapor Platformu</h2>
            </div>

            <div class="login-card">
                <div class="login-form">
                    <h3>Giris Yap</h3>

                    <div class="input-group">
                        <input type="text" id="username" placeholder="Kullanici Adi" autocomplete="username" />
                    </div>

                    <div class="input-group">
                        <input type="password" id="password" placeholder="Sifre" autocomplete="current-password" />
                    </div>

                    <button class="login-btn" onclick="Login();">Giris Yap</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/lib/jquery/jquery-3.7.1.min.js" asp-append-version="true"></script>
    <script src="~/assets/lib/jqueryconfirm/jquery-confirm.js" asp-append-version="true"></script>
    <script src="~/assets/lib/loadingjs/loading.js" asp-append-version="true"></script>

    <script>
        const loginUserUrl = '@Url.Action("LoginUser", "MobileAuth")';
        const homeIndexUrl = '@Url.Action("Index", "Home")';

        function Login() {
            const username = $("#username").val();
            const password = $("#password").val();

            if (!username || !password) {
                $.confirm({
                    title: 'Uyari',
                    content: 'Kullanici adi ve sifre bos birakilamaz.',
                    buttons: { TAMAM: function () { } }
                });
                return;
            }

            $.ajax({
                type: "POST",
                url: loginUserUrl,
                cache: false,
                data: { "Email": username, "Pass": password },
                success: function (res) {
                    const result = res?.Result ?? res?.result;
                    const msg = res?.Message ?? res?.message;
                    if (!res || !result || result.UserId <= 0) {
                        $.confirm({
                            title: msg?.message ?? "Hata",
                            content: msg?.message2 ?? "Hatali kullanici adi veya sifre.",
                            buttons: { TAMAM: function () { } }
                        });
                    } else {
                        $('body').loading({
                            stoppable: false,
                            message: '<div><div class="brand-spinner"></div><p class="loading-text">Oturumunuz aciliyor<span class="loading-dots"><span>.</span><span>.</span><span>.</span></span></p></div>'
                        });
                        setTimeout(function () {
                            $("body").loading('destroy');
                            window.location.href = homeIndexUrl;
                        }, 1500);
                    }
                },
                error: function () {
                    $.confirm({
                        title: 'Hata',
                        content: 'Sunucuya baglanilamadi. Lutfen tekrar deneyin.',
                        buttons: { TAMAM: function () { } }
                    });
                }
            });
        }

        $(document).on('keypress', 'input', function (e) {
            if (e.which === 13) Login();
        });
    </script>
</body>

</html>
