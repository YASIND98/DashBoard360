@model ReportViewModel

<link rel="stylesheet" href="~/css/npl-report.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/npl-filters.css" asp-append-version="true" />


<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">NPL Girişleri</h1>
    @await Html.PartialAsync("_AvatarArea")
</div>

<div class="breadcrumb-bar" id="nplBreadcrumbBar" style="display:none;">
    <div class="breadcrumb" id="nplBreadcrumb"></div>
</div>

@{
    Func<object, Microsoft.AspNetCore.Html.IHtmlContent> nplViewToggle = @<div class="segmented-control npl-view-toggle">
        <button type="button" class="segment active" data-view="chart">Grafik</button>
        <div class="divider"></div>
        <button type="button" class="segment" data-view="table">Tablo</button>
    </div>;
}

<!-- Filters -->
<div class="filters-row">
    <div class="mobile filters-mobile-header">
        <h1 class="page-title page-title-mobile">NPL Girişleri</h1>
        @nplViewToggle("")
    </div>
    <div class="filters-left">
        <div class="filter-dropdown-wrapper">
            <div class="filter-dropdown" id="nplRegionSelect">
                <span class="filter-label" id="nplRegionLabel">Bölge</span>
                <img src="~/images/down.svg" alt="" />
            </div>
            <div class="dropdown-panel" id="nplRegionPanel">
                <div class="dropdown-search">
                    <img src="~/images/search.svg" alt="" />
                    <input type="text" placeholder="Ara" class="dropdown-search-input" id="nplRegionSearch" />
                </div>
                <div class="dropdown-list" id="nplRegionList"></div>
            </div>
        </div>

        <div class="filter-dropdown-wrapper">
            <div class="filter-dropdown" id="nplBranchSelect">
                <span class="filter-label" id="nplBranchLabel">Şube</span>
                <img src="~/images/down.svg" alt="" />
            </div>
            <div class="dropdown-panel" id="nplBranchPanel">
                <div class="dropdown-search">
                    <img src="~/images/search.svg" alt="" />
                    <input type="text" placeholder="Ara" class="dropdown-search-input" id="nplBranchSearch" />
                </div>
                <div class="dropdown-list" id="nplBranchList"></div>
            </div>
        </div>

        <div class="filter-dropdown-wrapper">
            <div class="filter-dropdown" id="nplPeriodSelect">
                <span class="filter-label" id="nplPeriodLabel">Dönem</span>
                <img src="~/images/down.svg" alt="" />
            </div>
            <div class="dropdown-panel" id="nplPeriodPanel">
                <div class="dropdown-search">
                    <img src="~/images/search.svg" alt="" />
                    <input type="text" placeholder="Ara" class="dropdown-search-input" />
                </div>
                <div class="dropdown-list" id="nplPeriodList" data-filter="period"></div>
            </div>
        </div>

        <div class="filter-dropdown-wrapper">
            <div class="filter-dropdown" id="nplProductSelect">
                <span class="filter-label" id="nplProductLabel">Ürün</span>
                <img src="~/images/down.svg" alt="" />
            </div>
            <div class="dropdown-panel" id="nplProductPanel">
                <div class="dropdown-search">
                    <img src="~/images/search.svg" alt="" />
                    <input type="text" placeholder="Ara" class="dropdown-search-input" />
                </div>
                <div class="dropdown-list" id="nplProductList" data-filter="product"></div>
            </div>
        </div>

        <div class="npl-filters-wrapper">
            <div class="filter-dropdown npl-filters-btn" id="nplFiltersBtn">
                <img src="~/images/filter.svg" alt="" />
                <span class="filter-label">Filtreler</span>
            </div>

            <!-- Karartma (yalnız tablet/mobil bottom-sheet'te görünür) -->
            <div class="npl-filters-overlay" id="nplFiltersOverlay"></div>

            <!-- Filtreler paneli: masaüstünde butonun altında, tablet/mobilde alttan bottom-sheet -->
            <div class="npl-filters-panel" id="nplFiltersPanel" role="dialog" aria-labelledby="nplFiltersTitle">
                <div class="npl-filters-header">
                    <h2 class="npl-filters-title" id="nplFiltersTitle">Filtreler</h2>
                    <button type="button" class="npl-filters-close" id="nplFiltersClose" aria-label="Kapat">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
                <div class="npl-filters-body" id="nplFilterGroups"></div>
                <div class="npl-filters-footer">
                    <button type="button" class="npl-filters-clear" id="nplFiltersClear">Filtreleri Temizle</button>
                    <button type="button" class="npl-filters-apply" id="nplFiltersApply">Sonuçları Göster</button>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_MobileMoreMenu")
    </div>
    <div class="desktop">
        @nplViewToggle("")
    </div>
</div>

@{
    Func<object, Microsoft.AspNetCore.Html.IHtmlContent> nplMetricToggle = @<div class="period-toggle npl-metric-toggle">
        <button class="period-btn active" data-metric="balance">
            <img src="~/images/balance.svg" alt="" class="period-icon" /> Bakiye
        </button>
        <button class="period-btn" data-metric="ratio">
            <img src="~/images/percentage.svg" alt="" class="period-icon" /> Oran
        </button>
    </div>;
}

<div class="tab-bar">
    <div class="tab-list" id="nplTabList"></div>
    <div class="desktop">
        @nplMetricToggle("")
    </div>
</div>

<!-- Bakiye / Oran (mobil) -->
<div class="mobile period-toggle-row">
    @nplMetricToggle("")
</div>

<!-- NPL Report Chart / Table -->
<div class="npl-chart-container">
    <div class="npl-chart-card" id="nplChartCard">
        <div class="npl-chart" id="nplChart"></div>
    </div>

    <div class="table-container" id="nplTableContainer" style="display:none;">
        <div class="table-wrapper">
            <table class="data-table" id="nplDataTable">
                <thead id="nplTableHead"></thead>
                <tbody id="nplTableBody"></tbody>
            </table>
        </div>
        
        <div class="table-legend" id="nplLegend">
            <span class="legend-note">Değerler milyon TL olarak gösterilmektedir.</span>
            <div class="npl-chart-legend" id="nplChartLegend">
                <span class="npl-legend-item"><i class="npl-legend-dot npl-legend-principal"></i>NPL Anapara</span>
                <span class="npl-legend-item"><i class="npl-legend-dot npl-legend-interest"></i>NPL Kat Öncesi Faiz</span>
            </div>
            <div class="legend-actions">
                <div class="download-pdf-btn" data-pdf="nplReport" style="cursor:pointer;">
                    <img src="~/images/download.svg" alt="PDF İndir" />
                    <span>PDF İndir</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/lib/html2canvas/html2canvas.min.js" asp-append-version="true"></script>
    <script src="~/assets/lib/jspdf/jspdf.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/download-pdf.js" asp-append-version="true"></script>
    <script src="~/js/npl-report/filter.js" asp-append-version="true"></script>
    <script src="~/js/npl-report/index.js" asp-append-version="true"></script>
}
