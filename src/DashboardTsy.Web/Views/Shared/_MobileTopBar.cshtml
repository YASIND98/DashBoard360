@{
    var _profilePhoto = Context?.Session?.GetString("ProfilePhoto") ?? string.Empty;
    var _nameSurname  = Context?.Session?.GetString("NameSurname")  ?? string.Empty;
    var _department   = Context?.Session?.GetString("Department")   ?? string.Empty;
    var _parts = _nameSurname.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var _initials = _parts.Length switch { >= 2 => $"{_parts[0][0]}{_parts[1][0]}", 1 => $"{_parts[0][0]}", _ => "AD" };
    _initials = _initials.ToUpperInvariant();
    var _avatarUrl = !string.IsNullOrEmpty(_profilePhoto)
        ? _profilePhoto
        : $"https://ui-avatars.com/api/?name={System.Net.WebUtility.UrlEncode(_initials)}&background=c44&color=fff&size=48&rounded=true";
}

<div class="mobile-top-bar" id="mobileTopBar">
    <button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menüyü aç">
        <img src="~/images/denizbank-logo.svg" alt="Logo" class="mobile-top-logo" id="mobileTopLogo" />
    </button>
    <div class="mobile-top-date" id="mobileTopDate">
        <span class="mobile-date-text" id="mobileTopDateText"></span>
        <!-- <span class="mobile-date-badge" id="mobileTopDateBadge"></span>
        <img src="~/images/down.svg" alt="" class="mobile-top-chevron" /> -->
    </div>
</div>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

<!-- Mobile Menu Drawer -->
<div class="mobile-menu-drawer" id="mobileMenuDrawer" role="dialog" aria-modal="true" aria-label="Navigasyon menüsü">
    <div class="mobile-menu-head">
        <div class="mobile-menu-user">
            <img src="@_avatarUrl" alt="Avatar" class="mobile-menu-avatar" />
            <div class="mobile-menu-user-info">
                @if (!string.IsNullOrEmpty(_nameSurname))
                {
                    <span class="mobile-menu-name">@_nameSurname</span>
                }
                @if (!string.IsNullOrEmpty(_department))
                {
                    <span class="mobile-menu-dept">@_department</span>
                }
            </div>
        </div>
        <button type="button" class="mobile-menu-close" id="mobileMenuClose" aria-label="Menüyü kapat">
            <svg class="mobile mobile-close-btn" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </button>
    </div>
    <nav class="mobile-menu-nav" id="mobileMenuNav"></nav>

    <!-- <div class="mobile-menu-footer">
        <button type="button" class="mobile-menu-footer-item">
            <img src="~/images/sun-moon.svg" alt="" />
            <span>Görünüm Tercihleri</span>
        </button>
        <a href="#" class="mobile-menu-footer-item">
            <img src="~/images/ky-logo.svg" alt="" />
            <span>Kutup Yıldızı'na Geri Dön</span>
        </a>
    </div> -->
</div>
