@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var activityUserId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId") ?? 0;
    var pageController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? "";
    var pageIdandClass = $"page-{pageController}";

    var sessionUser = System.Text.Json.JsonSerializer.Deserialize<DashboardTsy.Web.Models.UsersDto>(
        Context.Session.GetString("User") ?? "null");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <!-- Tema: localStorage'dan oku, FOUC'u önle -->
    <script>(function(){var t=localStorage.getItem('app-theme')||'dark';document.documentElement.setAttribute('data-theme',t);}());</script>
    <!-- PDF butonu sadece Chrome ve Edge'de gösterilir -->
    <script>
        (function () {
            var ua = navigator.userAgent;
            // Edge: Windows/Mac/Android "Edg/", Android "EdgA/", iOS "EdgiOS/"
            var isEdge = /Edg(A|iOS)?\//.test(ua);
            // Brave, UA'da kendini belirtmez ve Chrome gibi görünür; navigator.brave ile ayırt edilir.
            var isBrave = !!navigator.brave;
            // Chrome UA token'ı taşıyan ama Chrome olmayan tarayıcılar (Opera, UC Browser, vb.) ve botlar (Googlebot, vb.)
            var isOtherChromiumBrowser = /OPR\/|Opera|UCBrowser|SamsungBrowser|YaBrowser|Vivaldi|DuckDuckGo/i.test(ua);
            var isBot = /bot|spider|crawl/i.test(ua);
            // Chrome: desktop/Android "Chrome/", iOS "CriOS/"
            var isChrome = /Chrome\/|CriOS\//.test(ua) && !isEdge && !isBrave && !isOtherChromiumBrowser && !isBot;
            var isAllowedBrowser = isChrome || isEdge;
            document.documentElement.setAttribute('data-pdf-allowed', isAllowedBrowser ? 'true' : 'false');
        }());
    </script>
    <meta charset="utf-8" />
    <!-- <meta name="viewport" content="width=device-width, initial-scale=1.0" /> -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>Yönetici Raporu</title>
    <link href="~/assets/lib/google-fonts/inter/inter.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/breadcrumb-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/filters-row.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tab-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sub-tab-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report-detail-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/info-icon.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-top-bar.css" asp-append-version="true" />
</head>
<body id="@pageIdandClass" class="@pageIdandClass">
    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <img src="~/images/denizbank-logo.svg" alt="Logo" />
                <p class="sidebar-text">Yönetici Raporları</p>
            </div>
            <div id="sidebar-nav-items"></div>
            <a href="mailto:YoneticiRaporu@denizbank.com" class="sidebar-nav sidebar-feedback">
                <img src="~/images/feedback.svg" alt="Görüş ve Öneri" />
                <span class="sidebar-label">Görüş ve Öneri</span>
            </a>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            @await Html.PartialAsync("_MobileTopBar")
            @await Html.PartialAsync("_ThemePanel")
            @RenderBody()
        </div>
    </div>

    @if (activityUserId > 0)
    {
        <script>
            window._activityLogEnabled = true;
            window._activityLogUrl = '@Url.Content("~/api/ActivityLog/client")';
        </script>
    }
    <script>
        window.USER_CODE = @Html.Raw(Json.Serialize(sessionUser?.DomainName));
    </script>
    <script src="~/assets/lib/jquery/jquery-3.7.1.min.js" asp-append-version="true"></script>
    <link href="~/css/loading.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/assets/lib/loadingjs/loading.js" asp-append-version="true"></script>
    <script src="~/js/shared/formatter.js" asp-append-version="true"></script>
    <script src="~/js/shared/constants.js" asp-append-version="true"></script>
    <script src="~/js/shared/app-settings.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
