<div class="scorecard scorecard-nps" id="scorecardNps">
    <button class="scorecard-btn" id="scorecardBtn">
        <img class="desktop" src="~/images/down.svg" alt="" style="transform: rotate(90deg);" />
        <img class="mobile" src="~/images/score-card.svg" alt="" />
        <span class="scorecard-btn-label">Bölge Skor Kartı & NPS</span>
    </button>
    <div class="scorecard-panel" id="scorecardPanel">
        <div class="scorecard-header">
            <span class="scorecard-title">Bölge Skor Kartı & NPS</span>
            <button class="desktop scorecard-close" id="scorecardClose"><img src="~/images/close-circle.svg" alt="" /></button>
            <svg class="mobile mobile-close-btn scorecard-close" id="scorecardClose" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </div>
        <div class="sc-manager-card" id="scManagerCard" style="display:none;">
            <div class="sc-branch-photo-block" style="display:none;">
                <img class="sc-branch-photo" src="" alt="" />
                <button class="sc-zoom-btn" type="button">&#128269; Fotoğrafı Büyüt</button>
                <div class="sc-manager-info-overlay">
                    <span class="sc-avatar-zoom" title="Fotoğrafı Büyüt">
                        <img class="sc-manager-avatar" src="" alt="" />
                        <span class="sc-avatar-zoom-icon">&#128269;</span>
                    </span>
                    <div class="sc-manager-meta">
                        <span class="sc-manager-name">-</span>
                        <span class="sc-manager-role">-</span>
                    </div>
                </div>
            </div>
            <div class="sc-manager-info" style="display:none;">
                <span class="sc-avatar-zoom" title="Fotoğrafı Büyüt">
                    <img class="sc-manager-avatar" src="" alt="" />
                    <span class="sc-avatar-zoom-icon">&#128269;</span>
                </span>
                <div class="sc-manager-meta">
                    <span class="sc-manager-name">-</span>
                    <span class="sc-manager-role">-</span>
                </div>
            </div>
        </div>
        <div class="scorecard-content"></div>
    </div>
</div>

<!-- Lightbox -->
<div id="scLightboxOverlay" class="sc-lightbox-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.65); z-index:2000;">
    <div class="sc-lightbox-box">
        <div class="sc-lightbox-header">
            <span id="scLightboxTitle" class="sc-lightbox-title"></span>
            <button id="scLightboxClose" type="button" class="sc-lightbox-close">&#10005;</button>
        </div>
        <img id="scLightboxImg" class="sc-lightbox-img" src="" alt="" style="width:100%; display:block;" />
    </div>
</div>
