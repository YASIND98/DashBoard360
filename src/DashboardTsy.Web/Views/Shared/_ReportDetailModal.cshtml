<div class="report-detail-overlay" id="reportDetailOverlay">
  <div class="report-detail-modal">
    <div class="report-detail-header">
      <button class="report-detail-close" id="reportDetailClose">
        <img class="desktop" src="~/images/close-circle.svg" alt="Kapat" />
        <svg class="mobile mobile-close-btn" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
      <span class="report-detail-title"></span>
      @await Html.PartialAsync("_MobileMoreMenu", new ViewDataDictionary(ViewData) { { "variant", "reportDetail" } })
    </div>
    <div class="report-detail-tabs" id="reportDetailTabs">
      <button type="button" class="report-detail-tab active" data-report-detail-tab="breakdown">Bölge/Şube/Portföy Kırılımı</button>
      <button type="button" class="report-detail-tab" data-report-detail-tab="top10" id="reportDetailTop10TabBtn">İlk 10 &amp; Son 10 Sıralaması</button>
      <button type="button" class="report-detail-tab" data-report-detail-tab="trend" id="reportDetailTrendTabBtn" style="display:none;">Trend Analizi</button>
    </div>

    <div class="report-detail-tab-content" id="reportDetailBreakdownTab">
      <div class="table-container">
        <div class="table-wrapper">
          <table class="data-table">
            <thead id="reportDetailBdHead"></thead>
            <tbody id="reportDetailBdBody"></tbody>
          </table>
        </div>
        <div class="table-legend">
          <span class="legend-note">Tablodaki değerler /1000 olarak verilmektedir.</span>
          <div class="legend-colors"></div>
          <div class="legend-actions">
            <div class="diff-toggle" id="reportDetailDiffToggle" data-active="true">
              <img src="~/images/switch-inactive.svg" class="switch-icon inactive" alt="switch off" />
              <img src="~/images/switch-active.svg" class="switch-icon active" alt="switch on" />
              <span>Farkları Göster</span>
            </div>
            <div class="download-pdf-btn" data-pdf="reportBreakdown" style="cursor:pointer;">
              <img src="~/images/download.svg" alt="PDF İndir" /><span>PDF İndir</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="report-detail-tab-content report-detail-hidden" id="reportDetailTop10Tab">
      @await Html.PartialAsync("_Top10PeriodToggle")
      <div class="top10-body">
        <div class="top10-column">
          <h3 class="top10-column-title">İlk 10</h3>
          <div class="top10-list" id="top10First"></div>
        </div>
        <div class="top10-column">
          <h3 class="top10-column-title">Son 10</h3>
          <div class="top10-list" id="top10Last"></div>
        </div>
      </div>
      <span class="legend-note" style="display:inline-block;margin-top:16px">Tablodaki değerler /1000 olarak verilmektedir.</span>
    </div>

    <div class="report-detail-tab-content report-detail-hidden" id="reportDetailTrendTab">
      <div id="reportDetailTrendChart"></div>
      <div class="table-legend">
        <div class="legend-actions" style="margin-left:auto;">
          <div class="download-pdf-btn" data-pdf="reportTrend" style="cursor:pointer;">
            <img src="~/images/download.svg" alt="PDF İndir" /><span>PDF İndir</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
