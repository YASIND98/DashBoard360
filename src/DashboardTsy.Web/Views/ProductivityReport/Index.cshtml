@model ReportViewModel



<link rel="stylesheet" href="~/css/ai.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/date-picker.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/usd-kur-modal.css" asp-append-version="true" />

<!-- Page Title & Date -->
<div class="page-header">
    <h1 class="page-title">Verim Performans Raporları</h1>
    <div class="page-date">
        @await Html.PartialAsync("_DatePicker")
    </div>
    @await Html.PartialAsync("_AvatarArea")
</div>

<!-- Breadcrumb & Skor Kartı -->
<div class="breadcrumb-bar" id="breadcrumbBar" style="display:none;">
    <div class="breadcrumb" id="yieldBreadcrumb"></div>
    <div class="scorecard-nps-wrapper desktop">
        @await Html.PartialAsync("_ScorecardNps")
    </div>
</div>

<!-- Filters -->
<div class="filters-row">
    <div class="mobile filters-mobile-header">
        <h1 class="page-title page-title-mobile mobile">Verim Performans Raporları</h1>
        <div class="scorecard-nps-wrapper mobile" id="mobileScorecardWrapper" style="display:none;">
            @await Html.PartialAsync("_ScorecardNps")
        </div>
    </div>
    <div class="filters-left">
        <div class="filter-dropdown-wrapper">
            <div class="filter-dropdown" id="yieldBolgeSelect">
                <span class="filter-label" id="yieldBolgeLabel">Bölge</span>
                <img src="~/images/down.svg" alt="" />
            </div>
            <div class="dropdown-panel" id="yieldBolgePanel">
                <div class="dropdown-search">
                    <img src="~/images/search.svg" alt="" />
                    <input type="text" placeholder="Ara" class="dropdown-search-input" id="yieldBolgeSearch" />
                </div>
                <div class="dropdown-list" id="yieldBolgeList"></div>
            </div>
        </div>
        <div class="filter-dropdown-wrapper">
            <div class="filter-dropdown" id="yieldSubeSelect">
                <span class="filter-label" id="yieldSubeLabel">Şube</span>
                <img src="~/images/down.svg" alt="" />
            </div>
            <div class="dropdown-panel" id="yieldSubePanel">
                <div class="dropdown-search">
                    <img src="~/images/search.svg" alt="" />
                    <input type="text" placeholder="Ara" class="dropdown-search-input" id="yieldSubeSearch" />
                </div>
                <div class="dropdown-list" id="yieldSubeList"></div>
            </div>
        </div>
      <div class="filter-search">
          <img src="~/images/search.svg" alt="" />
          <input type="text" placeholder="Ara" id="yieldSearchInput" />
      </div>
      @await Html.PartialAsync("_MobileMoreMenu")
    </div>
    <div class="segmented-control" id="yieldToggle" style="display:none;"></div>
</div>

<!-- Tab Bar (Level 2) -->
<div class="tab-bar" id="tabBar" style="display:none;">
  <div class="tab-list" id="tabBarList"></div>
  <div></div>
</div>

<!-- Sub Tab Bar (Level 3) -->
<div class="sub-tab-bar" id="subTabBar" style="display:none;">
  <div class="tab-list" id="subTabBarList"></div>
</div>

<!-- Second Dynamic Table (for Karlılık) -->
<div class="table-container" id="dynamicTableContainer2" style="display:none; margin-bottom:16px;">
    <table class="data-table yield-table" id="dynamicTable2">
        <thead id="dynamicTableHead2"></thead>
        <tbody id="dynamicTableBody2"></tbody>
    </table>
</div>
<div id="pageSkeleton" class="page-skeleton">
    <div class="skeleton-table" id="yieldInitialSkeleton">
        @for (var i = 0; i < 8; i++)
        {
            <div class="skeleton-table-row">
                <div class="skeleton-bar" style="width:30px;height:16px"></div>
                <div class="skeleton-bar" style="width:55%;height:16px"></div>
                <div class="skeleton-bar" style="width:16%;height:16px"></div>
                <div class="skeleton-bar" style="width:16%;height:16px"></div>
                <div class="skeleton-bar" style="width:16%;height:16px"></div>
                <div class="skeleton-bar" style="width:16%;height:16px"></div>
                <div class="skeleton-bar" style="width:16%;height:16px"></div>
            </div>
        }
    </div>
</div>

<!-- Dynamic Table (headers from service) -->
<div class="table-container" id="dynamicTableContainer" style="display:none;">
    <div class="table-wrapper">
      <table class="data-table yield-table" id="dynamicTable">
          <thead id="dynamicTableHead"></thead>
          <tbody id="dynamicTableBody"></tbody>
      </table>
    </div>
    <div class="table-legend" id="tableLegend"></div>
</div>

<!-- AI İçgörüleri (Floating Button) -->
<div class="ai-insights" id="aiInsightsContainer" style="display:none;">
    <a href="#" class="ai-insights-btn" id="aiInsightsBtn">
        <img src="~/images/ai-logo.svg" alt="AI" />
        <span class="ai-insights-label">AI İçgörüleri</span>
    </a>
</div>

<!-- AI İçgörüleri (Drawer) -->
<div class="ai-drawer-overlay" id="aiDrawerOverlay"></div>
<aside class="ai-drawer" id="aiDrawer">
    <div class="ai-drawer-header">
      <img id="aiDrawerClose" class="ai-drawer-close" src="~/images/close-circle.svg" alt="Kapat" />
      <span class="ai-drawer-title">AI İçgörüleri</span>
    </div>
    <div class="ai-drawer-body">
        <p class="ai-drawer-desc">
          Tabloya ait AI içgörüsünü görmek için bölge ve şube seçmelisiniz.
        </p>

        <div class="ai-notice" id="aiNotice"></div>

        <div class="ai-filter-bar">
            <span class="ai-filter-tag">Seçili sorgu</span>

            <div class="filter-dropdown-wrapper">
                <div class="filter-dropdown" id="aiBolgeSelect">
                    <span class="filter-label" id="aiBolgeLabel">Bölge Seçiniz</span>
                    <img src="~/images/down.svg" alt="" />
                </div>
                <div class="dropdown-panel" id="aiBolgePanel">
                    <div class="dropdown-search">
                        <img src="~/images/search.svg" alt="" />
                        <input type="text" placeholder="Ara" class="dropdown-search-input" id="aiBolgeSearch" />
                    </div>
                    <div class="dropdown-list" id="aiBolgeList"></div>
                </div>
            </div>

            <div class="filter-dropdown-wrapper">
                <div class="filter-dropdown" id="aiSubeSelect">
                    <span class="filter-label" id="aiSubeLabel">Şube Seçiniz</span>
                    <img src="~/images/down.svg" alt="" />
                </div>
                <div class="dropdown-panel" id="aiSubePanel">
                    <div class="dropdown-search">
                        <img src="~/images/search.svg" alt="" />
                        <input type="text" placeholder="Ara" class="dropdown-search-input" id="aiSubeSearch" />
                    </div>
                    <div class="dropdown-list" id="aiSubeList"></div>
                </div>
            </div>

            <button class="ai-drawer-submit" id="aiDrawerSubmit" type="button" disabled>AI İçgörüsü Oluştur</button>
        </div>

        <div class="ai-result" id="aiResult"></div>
    </div>
</aside>

@await Html.PartialAsync("_ReportDetailModal")

@await Html.PartialAsync("_UsdKurModal")

@section Scripts {
    <script src="~/assets/lib/html2canvas/html2canvas.min.js" asp-append-version="true"></script>
    <script src="~/assets/lib/jspdf/jspdf.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/report-detail.js" asp-append-version="true"></script>
    <script src="~/js/productivity-report.js" asp-append-version="true"></script>
    <script src="~/js/download-pdf.js" asp-append-version="true"></script>
    <script src="~/js/ai-insights.js" asp-append-version="true"></script>
    <script src="~/js/date-picker.js" asp-append-version="true"></script>
    <script src="~/js/shared/usd-kur-modal.js" asp-append-version="true"></script>
    <script>
    $(document).ready(function () {

        // Rapor tarihini paylaşımlı usd-kur-modal.js'e ilet
        window._getUsdKurDate = function () { return _selectedDate; };

        // AI İçgörüleri butonunu backend ayarına göre göster/gizle.
        AppSettings.isVisible('ProductivityReport.AiInsight.Visible').then(function (visible) {
            $('#aiInsightsContainer').toggle(visible);
        });

        // Data field mapping per section (by section index in OrderNo)
        // Region returns 2 sections (manager+roles, NPS); Branch returns 3 sections (manager+months, roles, NPS).
        var _sectionFieldsRegion = [
            ['ManagerName', 'CorporateScore', 'CommercialScore', 'KobiScore', 'ObiScore', 'AgricultureScore', 'MassScore', 'AffluentScore', 'PrivateBankingScore'],
            null // NPS via getNpsFields
        ];

        var _sectionFieldsBranch = [
            ['ManagerName', 'FirstMonthScore', 'SecondMonthScore', 'ThirdMonthScore'],
            ['CorporateScore', 'CommercialScore', 'KobiScore', 'ObiScore', 'AgricultureScore', 'MassScore', 'AffluentScore', 'PrivateBankingScore'],
            null // NPS via getNpsFields
        ];

        function getNpsFields(isBranch) {
            return isBranch ? ['BranchNpsScore', 'BankNpsScore'] : ['RegionNpsScore', 'BankNpsScore'];
        }

        // ===== State =====
        var selectedRegion = null;
        var selectedBranch = null;

        // ===== Filter Lists =====
        function renderRegionDropdown() {
            return renderRegionList('#yieldBolgeList', selectedRegion ? selectedRegion.code : null);
        }

        function renderBranchDropdown() {
            return renderBranchList('#yieldSubeList', selectedBranch ? selectedBranch.code : null, selectedRegion ? selectedRegion.code : null);
        }

        function reloadCurrent() {
            if (selectedRegion || selectedBranch) updateUI();
            else updateYieldTable();
        }

        loadTodayDate(function () {
            _selectedDate = _todayDate;
            if (window.DatePicker) {
                DatePicker.init({
                    initial: new Date(_todayDate),
                    readOnly: true,
                    label: 'Haziran 2026'
                });
            }
            // Sekmeler yalnızca sayfa ilk açılışında çekilir; bölge/şube seçimi tekrar tetiklemez
            loadProductivityTabs(1, function () {
                loadRegionFilters(function () {
                    var single = renderRegionDropdown();
                    if (single) {
                        selectedRegion = { code: single.Code, name: single.Name };
                    }
                    loadBranchFilters(function () {
                        var singleBranch = renderBranchDropdown();
                        if (singleBranch) {
                            selectedBranch = { code: singleBranch.Code, name: singleBranch.Name };
                        }
                        if (selectedRegion || selectedBranch) {
                            updateUI();
                        } else {
                            updateYieldTable();
                        }
                    });
                });
            });
        });

        // ===== Region Selection =====
        $(document).on('click', '#yieldBolgeList .dropdown-item', function () {
            var code = $(this).attr('data-code');
            var name = $(this).text();

            selectedRegion = code ? { code: code, name: name } : null;
            $('#yieldBolgeLabel').text(code ? name : 'Bölge');

            selectedBranch = null;
            $('#yieldSubeLabel').text('Şube');

            $('#yieldBolgeList .dropdown-item').removeClass('selected');
            $(this).addClass('selected');
            $('#yieldBolgePanel').removeClass('open');
            $('#yieldBolgeSearch').val('');

            renderBranchDropdown();

            updateUI();
        });

        // ===== Branch Selection =====
        $(document).on('click', '#yieldSubeList .dropdown-item', function () {
            var code = $(this).attr('data-code');
            var name = $(this).text();

            if (!code) {
                selectedBranch = null;
                $('#yieldSubeLabel').text('Şube');
            } else {
                var regionCode = $(this).attr('data-region');
                selectedBranch = { code: code, name: name };
                $('#yieldSubeLabel').text(name);

                var region = findRegion(regionCode);
                if (region) {
                    selectedRegion = { code: region.Code, name: region.Name };
                    $('#yieldBolgeLabel').text(region.Name);
                    $('#yieldBolgeList .dropdown-item').removeClass('selected');
                    $('#yieldBolgeList .dropdown-item[data-code="' + region.Code + '"]').addClass('selected');
                }
            }

            $('#yieldSubeList .dropdown-item').removeClass('selected');
            $(this).addClass('selected');
            $('#yieldSubePanel').removeClass('open');
            $('#yieldSubeSearch').val('');

            updateUI();
        });

        $(document).on('click', '.sc-zoom-btn', function () {
            var src  = $(this).siblings('.sc-branch-photo').attr('src');
            var name = $(this).closest('.sc-branch-photo-block').find('.sc-manager-role').text();
            $('.sc-lightbox-img').attr('src', src);
            $('.sc-lightbox-title').text(name);
            $('.sc-lightbox-overlay').fadeIn(180);
        });

        $(document).on('click', '.sc-lightbox-close, .sc-lightbox-overlay', function (e) {
            e.stopPropagation(); 
            if ($(e.target).is('.sc-lightbox-overlay') || $(e.target).is('.sc-lightbox-close')) {
                $('.sc-lightbox-overlay').fadeOut(180);
            }
        });

        // ===== UI Update =====
        function updateUI() {
            updateBreadcrumb();
            updateScorecard();

            if (selectedRegion || selectedBranch) {
                applyYieldScope(true);
                $('#yieldToggle').show();
                updateYieldTable();
            } else {
                applyYieldScope(false);
                $('#yieldToggle').hide();
                updateYieldTable();
            }
        }

        // ===== Breadcrumb =====
        function crumb(text, action, isSingle) {
            var cls = isSingle ? ' disabled' : '';
            var attr = !isSingle && action ? ' data-breadcrumb="' + action + '"' : '';
            return '<span class="breadcrumb-item' + cls + '"' + attr + '>' + text + '</span>';
        }

        function updateBreadcrumb() {
            if (!selectedRegion && !selectedBranch) {
                $('#breadcrumbBar').hide();
                $('#mobileScorecardWrapper').hide();
                return;
            }

            $('#breadcrumbBar').show();
            $('#mobileScorecardWrapper').show();
            var singleRegion = _regionFilters.length === 1;
            var parts = [crumb('Tüm Bölgeler', 'allRegions', singleRegion)];

            if (selectedRegion) {
                parts.push(crumb(selectedRegion.name + ' Bölgesi', 'region', singleRegion));
            }
            if (selectedBranch) {
                parts.push(crumb(selectedBranch.name + ' Şubesi', null, true));
            }

            $('#yieldBreadcrumb').html(parts.join('<span class="breadcrumb-separator">/</span>'));
        }

        $(document).on('click', '[data-breadcrumb="allRegions"]', function () {
            selectedRegion = null;
            selectedBranch = null;
            $('#yieldBolgeLabel').text('Bölge');
            $('#yieldBolgeList .dropdown-item').removeClass('selected');
            $('#yieldSubeLabel').text('Şube');
            renderBranchDropdown();
            updateUI();
        });

        $(document).on('click', '[data-breadcrumb="region"]', function () {
            selectedBranch = null;
            $('#yieldSubeLabel').text('Şube');
            renderBranchDropdown();
            updateUI();
        });

        // ===== Scorecard =====
        function updateScorecard() {
            var isBranch = selectedBranch !== null;
            var filterType = isBranch ? 2 : 1;
            var label = isBranch ? 'Şube Skor Kartı & NPS' : 'Bölge Skor Kartı & NPS';
            $('#scorecardBtnLabel').text(label);
            $('#scorecardTitle').text(label);

            if (!selectedRegion && !selectedBranch) {
                $('.scorecard-content').html('');
                return;
            }

            var url = isBranch
                ? '/ProductivityReport/GetProductivityBranchScoreCardReport'
                : '/ProductivityReport/GetProductivityRegionScoreCardReport';

            var payload = isBranch
                ? { sessionId: '1', branchCode: selectedBranch.code, reportDate: _selectedDate }
                : { sessionId: '1', regionCode: selectedRegion.code, reportDate: _selectedDate };

            loadScoreCardHeaders(filterType, function (headers) {
                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (d) {
                        renderScorecardHtml(headers, d, isBranch);
                        updateManagerCard(d, isBranch);
                    }
                });
            });
        }

        function renderScorecardHtml(headers, d, isBranch) {
            // Group: sections (ParentId=0) and their children
            var sections = headers
                .filter(function (h) { return h.ParentId === 0; })
                .sort(function (a, b) { return a.OrderNo - b.OrderNo; });

            var sectionFields = isBranch ? _sectionFieldsBranch : _sectionFieldsRegion;
            var html = '';

            sections.forEach(function (section, sIdx) {
                var children = headers
                    .filter(function (h) { return h.ParentId === section.Id; })
                    .sort(function (a, b) { return a.OrderNo - b.OrderNo; });

                var fields = (sIdx < sectionFields.length && sectionFields[sIdx])
                    ? sectionFields[sIdx]
                    : getNpsFields(isBranch);

                html += '<div class="scorecard-section">';
                html += '<div class="scorecard-section-title">' + section.HeaderName + '</div>';
                html += '<table class="scorecard-table">';

                children.forEach(function (child, cIdx) {
                    var fieldName = cIdx < fields.length ? fields[cIdx] : null;
                    var value = fieldName ? d[fieldName] : null;

                    if (fieldName === 'ManagerName') {
                        html += '<tr><td>' + child.HeaderName + ':</td><td>' + (value || '-') + '</td></tr>';
                    } else {
                        var score = value != null ? formatPercent(value) : '-';
                        var cls = value != null ? ' ' + percentColor(value) : '';
                        html += '<tr><td>' + child.HeaderName + ':</td><td class="' + cls.trim() + '">' + score + '</td></tr>';
                    }
                });

                html += '</table></div>';
            });

            $('.scorecard-content').html(html);
        }

        // ===== Scorecard Panel Toggle =====
        $('.scorecard-nps .scorecard-btn').on('click', function (e) {
            e.stopPropagation();
            $(e.target).closest('.scorecard-nps').find('.scorecard-panel').toggleClass('open');
        });
        $('.scorecard-nps .scorecard-close').on('click', function () {
            $(this).closest('.scorecard-nps').find('.scorecard-panel').removeClass('open');
        });
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.scorecard-nps').length) {
                $('.scorecard-nps .scorecard-panel').removeClass('open');
            }
        });

        // ===== Tab Change Callback =====
        window.onProductivityTabChange = function () {
            updateYieldTable();
        };

        var _fallbackAvatar = '/images/icon-profile.png';

        function setImgWithFallback($img, src) {
            $img.attr('src', src || _fallbackAvatar)
                .off('error')
                .on('error', function () {
                    $(this).off('error').attr('src', _fallbackAvatar);
                });
        }
        
        // ─── Manager Row / append & hide  ─────────────────────────────────────────────────────────
        function updateManagerCard(data, isBranch) {
            if (!data) return;
            var $card  = $('.sc-manager-card');
            var $photo = $card.find('.sc-branch-photo-block');
            var $info  = $card.find('.sc-manager-info');

            // 1. Doğrudan değerleri oku (PascalCase / camelCase fallback)
            var managerName        = data.ManagerName        || data.managerName        || '-';
            var branchPhoto        = data.BranchPhoto        || data.branchPhoto        || null;
            var branchManagerPhoto = data.BranchManagerPhoto || data.branchManagerPhoto || null;
            var regionManagerPhoto = data.RegionManagerPhoto || data.regionManagerPhoto || null;

            // 2. Rol metnini belirle
            var roleText = isBranch 
                ? ((selectedBranch ? selectedBranch.name + ' ' : '') + 'Şube Müdürü')
                : ((selectedRegion ? selectedRegion.name + ' ' : '') + 'Bölge Müdürü');

            // 3. Ekrana basma işlemini şartlardan bağımsız en başta yap (HER İKİ ALANA DA YAZ)
            $photo.find('.sc-manager-name').text(managerName);
            $photo.find('.sc-manager-role').text(roleText);
            $info.find('.sc-manager-name').text(managerName);
            $info.find('.sc-manager-role').text(roleText);

            $card.show();
            // 4. Sadece görünürlük ve resim atamalarını koşula bağla
            if (branchPhoto) {
                setImgWithFallback($photo.find('.sc-branch-photo'), branchPhoto);
                setImgWithFallback($photo.find('.sc-manager-avatar'), branchManagerPhoto);
                $photo.show().addClass('with-bg');
                $card.removeClass('area');
                $info.hide();
            } else {
                var avatarPhoto = isBranch ? branchManagerPhoto : regionManagerPhoto;
                setImgWithFallback($info.find('.sc-manager-avatar'), avatarPhoto);
                $photo.hide().removeClass('with-bg');
                $card.addClass('area');
                $info.show();
            }
        }
        // ===== Table Update =====
        function updateYieldTable() {
            $('#yieldSearchInput').val('');
            var tabIds = getActiveTabIds();
            var filterType = selectedBranch ? 2 : 1;
            var toggleId = tabIds.toggleId || 1;
            var regionCode = selectedRegion ? selectedRegion.code : null;
            var branchCode = selectedBranch ? selectedBranch.code : null;

            showYieldTableLoading();

            // Update legend based on active tab
            var isBranch = selectedBranch !== null;
            var diffLabel = isBranch ? 'Şube ile Bölge ve Bankanın Farkı' : 'Bölge ile Bankanın Farkı';
            var note = 'Tablodaki değerler /1000 olarak verilmektedir.';

            if (toggleId === 1) {
                renderTableLegend('#tableLegend', { note: note, ratio: true });
            } else if (toggleId === 2) {
                renderTableLegend('#tableLegend', { diff: diffLabel });
            } else if (toggleId === 3) {
                renderTableLegend('#tableLegend', { note: note, diff: diffLabel, usdKur: true });
            } else if (toggleId === 4 && tabIds.tabId === 41) {
                renderTableLegend('#tableLegend', { note: note, diff: diffLabel });
            } else if (toggleId === 4) {
                renderTableLegend('#tableLegend', { note: note, diff: diffLabel, ratio: isBranch });
            }

            if (toggleId === 2 && tabIds.tabId === 11 && (selectedRegion || selectedBranch)) {
                if (selectedBranch) loadCountCardPosRatioBranchReport(branchCode, 1);
                else loadCountCardPosRatioRegionReport(regionCode, 1);
                return;
            }

            loadTableHeaders(toggleId, tabIds.tabId, tabIds.subTabId, filterType, function () {
                if (toggleId === 1) {
                    loadGeneralRegionReport(tabIds.tabId);
                }
                // Volume - region
                else if (toggleId === 3 && selectedRegion && !selectedBranch) {
                    loadVolumeRegionReport(regionCode, tabIds.tabId || 0);
                }
                // Volume - branch
                else if (toggleId === 3 && selectedBranch) {
                    loadVolumeBranchReport(branchCode, tabIds.tabId || 0);
                }
                // Count - branch - Cash Management
                else if (toggleId === 2 && selectedBranch && tabIds.tabId === 12) {
                    loadCountCashManagementBranchReport(branchCode, tabIds.subTabId || 0);
                }
                // Count - branch - Customer
                else if (toggleId === 2 && selectedBranch) {
                    loadCountCustomerBranchReport(branchCode, tabIds.subTabId || 0);
                }
                // Count - region - Cash Management
                else if (toggleId === 2 && selectedRegion && !selectedBranch && tabIds.tabId === 12) {
                    loadCountCashManagementRegionReport(regionCode, tabIds.subTabId || 0);
                }
                // Count - region - Customer
                else if (toggleId === 2 && selectedRegion && !selectedBranch) {
                    loadCountCustomerRegionReport(regionCode, tabIds.subTabId || 0);
                }
                // Profit - branch - Total
                else if (toggleId === 4 && selectedBranch && (tabIds.tabId === 40 || tabIds.tabId === null)) {
                    loadProfitTotalBranchReport(branchCode);
                    loadProfitRatioBranchReport(branchCode);
                }
                // Profit - branch - Spread
                else if (toggleId === 4 && selectedBranch && tabIds.tabId === 41) {
                    loadProfitSpreadManagementBranchReport(branchCode);
                }
                // Profit - region - Spread
                else if (toggleId === 4 && selectedRegion && !selectedBranch && tabIds.tabId === 41) {
                    loadProfitSpreadManagementRegionReport(regionCode);
                }
                // Profit - region - Total
                else if (toggleId === 4 && selectedRegion && !selectedBranch) {
                    loadProfitTotalRegionReport(regionCode);
                    loadProfitRatioRegionReport(regionCode);
                }
            });
        }

        // ===== Expandable Rows =====
        $(document).on('click', '.expandable', function () {
            var $row = $(this);
            var parentDepth = getDepth($row);
            var isExpanded = $row.hasClass('expanded');

            $row.toggleClass('expanded');

            if (isExpanded) {
                $row.nextAll('tr').each(function () {
                    var d = getDepth($(this));
                    if (d <= parentDepth) return false;
                    $(this).removeClass('visible expanded');
                });
            } else {
                var childDepth = parentDepth + 1;
                $row.nextAll('tr').each(function () {
                    var d = getDepth($(this));
                    if (d <= parentDepth) return false;
                    if (d === childDepth) $(this).addClass('visible');
                });
            }

            if ($row.closest('#dynamicTable2').length) {
                updateProductivityStripes2();
            } else {
                updateProductivityStripes();
            }
        });

        function getDepth($tr) {
            var match = $tr.attr('class').match(/depth-(\d+)/);
            return match ? parseInt(match[1]) : 0;
        }
    });
    </script>
}
